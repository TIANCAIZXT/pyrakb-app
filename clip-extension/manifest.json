{
  "manifest_version": 3,
  "name": "Mini Wiki 剪藏",
  "version": "1.0.0",
  "description": "在网页中选中文字，一键收录到 Mini Wiki 桌面应用",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": false
    }
  ],
  "action": { "default_title": "添加到 Mini Wiki" }
}
